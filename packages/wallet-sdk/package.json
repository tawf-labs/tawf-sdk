{
  "name": "@tawf/wallet-sdk",
  "version": "1.0.0",
  "description": "React Native SDK for Tawf DID Protocol wallet integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "react-native": "./src/index.ts"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/core/index.js"
    },
    "./chains": {
      "types": "./dist/chains/index.d.ts",
      "import": "./dist/esm/chains/index.js",
      "require": "./dist/chains/index.js"
    },
    "./circuits": {
      "types": "./dist/circuits/index.d.ts",
      "import": "./dist/esm/circuits/index.js",
      "require": "./dist/circuits/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "android",
    "ios"
  ],
  "scripts": {
    "build": "tsc -b --force && tsc -p tsconfig.esm.json && node scripts/mark-esm.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "wallet",
    "sdk",
    "react-native",
    "did",
    "zk-proof",
    "midnight",
    "tawf"
  ],
  "author": "Tawf Islamic Foundation",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.14.0",
    "@midnight-ntwrk/midnight-js": "^4.0.3",
    "@solana/web3.js": "^1.87.0",
    "@tawf/types": "workspace:*",
    "ethers": "^6.9.0",
    "eventemitter3": "^5.0.1",
    "fast-base64-decode": "^1.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/typescript-config": "^0.74.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.0"
  },
  "module": "dist/esm/index.js"
}
