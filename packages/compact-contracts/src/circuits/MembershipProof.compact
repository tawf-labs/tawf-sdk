/**
 * MembershipProof.compact - DAO Membership Verification Circuit
 *
 * This zero-knowledge circuit allows TID holders to prove their membership
 * in a DAO without revealing their identity. It prevents double-voting through
 * the use of nullifiers.
 *
 * The circuit proves:
 * 1. The prover holds a valid TID
 * 2. The TID has not been revoked
 * 3. The TID has the appropriate credential type for DAO membership
 * 4. The nullifier has not been used before (prevents double-voting)
 *
 * Privacy: The TID hash and owner identity remain private
 *
 * @module MembershipProof
 * @pragma language_version 0.20
 */

pragma language_version 0.20;

// ============================================================================
// Imports and References
// ============================================================================

// Reference to TIDCore for TID registry access
// This would be imported in actual implementation

// ============================================================================
// Constants
// ============================================================================

/// Minimum credential type for DAO membership
const DAO_MEMBER_CREDENTIAL_TYPE: Uint<8> = 3;

/// Nullifier derivation key (for preventing double-voting across different proposals)
const NULLIFIER_DERIVATION_KEY: Field = 2718281828;

// ============================================================================
// Structs
// ============================================================================

/// Membership proof output
struct MembershipResult {
    /// Unique nullifier for this proof
    nullifier: Field;
    /// Whether membership is valid
    isValid: Bool;
    /// DAO identifier
    daoId: Field;
    /// Proof timestamp
    timestamp: Uint<64>;
}

/// Voting nullifier for double-vote prevention
struct VotingNullifier {
    /// The nullifier value
    value: Field;
    /// DAO identifier
    daoId: Field;
    /// Proposal/Action identifier
    actionId: Field;
    /// Creation timestamp
    timestamp: Uint<64>;
}

/// DAO membership tier
enum MembershipTier {
    /// Basic member (can vote on some proposals)
    BASIC = 0,
    /// Full member (can vote on all proposals)
    FULL = 1,
    /// Council member (can propose)
    COUNCIL = 2,
    /// Admin (full permissions)
    ADMIN = 3
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Compute nullifier from TID hash and context
/// @param tidHash Hash of the TID
/// @param daoId Identifier of the DAO
/// @param actionId Identifier of the specific action/proposal
/// @returns Unique nullifier value
function computeNullifier(tidHash: Field, daoId: Field, actionId: Field) -> Field {
    // Hash the combination to create a unique nullifier
    let combined = hash<Poseidon>(tidHash, daoId, actionId);
    return hash<Poseidon>(combined, NULLIFIER_DERIVATION_KEY);
}

/// Verify TID is valid for DAO participation
/// @param tidHash Hash of the TID to verify
/// @returns true if valid
function verifyTIDForDAO(tidHash: Field) -> Bool {
    // In actual implementation, this would query TIDCore
    // For now, assume tidRegistry is accessible

    // Check TID exists
    // if (!tidRegistry.contains(tidHash)) { return false; }

    // Check TID is not revoked
    // if (revocationList[tidHash]) { return false; }

    // Check TID has appropriate credential type
    // let tid = tidRegistry[tidHash];
    // if (tid.credentialType < DAO_MEMBER_CREDENTIAL_TYPE) { return false; }

    return true;
}

/// Get membership tier from credential type
/// @param credentialType The TID credential type
/// @returns Corresponding membership tier
function getMembershipTier(credentialType: Uint<8>) -> MembershipTier {
    if (credentialType == 5) {
        return MembershipTier.ADMIN;
    } else if (credentialType == 4) {
        return MembershipTier.COUNCIL;
    } else if (credentialType == 3) {
        return MembershipTier.FULL;
    } else {
        return MembershipTier.BASIC;
    }
}

// ============================================================================
// Main Circuit
// ============================================================================

/**
 * Verify DAO membership without revealing identity
 *
 * This circuit generates a proof that:
 * 1. The prover holds a valid TID with DAO membership credential
 * 2. The TID has not been revoked
 * 3. The proof is tied to a specific nullifier to prevent double-voting
 *
 * @param tidHash Private: Hash of the prover's TID
 * @param ownerKey Private: Prover's private key (for signature)
 * @param daoId Public: Identifier of the DAO
 * @param actionId Public: Identifier for the specific action/proposal
 * @param credentialType Public: Type of credential (for membership tier)
 * @returns Membership proof with nullifier
 */
export circuit verifyMembership(
    private tidHash: Field,
    private ownerKey: Field,
    public daoId: Field,
    public actionId: Field,
    public credentialType: Uint<8>
) -> MembershipResult {
    // Verify TID is valid for DAO participation
    require(verifyTIDForDAO(tidHash));

    // Verify credential type is sufficient for DAO membership
    require(credentialType >= DAO_MEMBER_CREDENTIAL_TYPE);

    // Compute nullifier for this specific action
    let nullifier = computeNullifier(tidHash, daoId, actionId);

    // Check if nullifier has been used
    // In actual implementation, query the nullifiers ledger
    // require(!nullifiers.contains(nullifier));

    // Register nullifier to prevent reuse
    // nullifiers[nullifier] = true;

    // Get membership tier
    let tier = getMembershipTier(credentialType);

    // Create result
    let result = MembershipResult {
        nullifier: nullifier,
        isValid: true,
        daoId: daoId,
        timestamp: block.timestamp
    };

    // Emit membership verified event
    emit<MembershipVerified>(
        nullifier,
        daoId,
        cast<Uint<8>>(tier),
        block.timestamp
    );

    return result;
}

// ============================================================================
// Voting Circuit
// ============================================================================

/**
 * Generate proof for voting on a proposal
 *
 * This is a specialized version of verifyMembership optimized for voting.
 *
 * @param tidHash Private: Hash of the voter's TID
 * @param proposalId Public: Identifier of the proposal
 * @param daoId Public: Identifier of the DAO
 * @param voteChoice Public: The vote choice (hashed)
 * @returns Voting nullifier
 */
export circuit vote(
    private tidHash: Field,
    public proposalId: Field,
    public daoId: Field,
    public voteChoice: Field,
    public credentialType: Uint<8>
) -> Field {
    // Verify membership
    require(verifyTIDForDAO(tidHash));
    require(credentialType >= DAO_MEMBER_CREDENTIAL_TYPE);

    // Compute voting nullifier
    let nullifier = computeNullifier(tidHash, daoId, proposalId);

    // Check not already voted
    // require(!nullifiers.contains(nullifier));

    // Register vote
    // nullifiers[nullifier] = true;

    // Emit vote event
    emit<VoteCast>(
        nullifier,
        daoId,
        proposalId,
        voteChoice,
        block.timestamp
    );

    return nullifier;
}

// ============================================================================
// Proposal Creation Circuit
// ============================================================================

/**
 * Verify authority to create proposals
 *
 * Council and admin members can create proposals.
 *
 * @param tidHash Private: Hash of the prover's TID
 * @param daoId Public: Identifier of the DAO
 * @param proposalHash Public: Hash of the proposal content
 * @param credentialType Public: Type of credential
 * @returns Proposal creation proof
 */
export circuit createProposal(
    private tidHash: Field,
    public daoId: Field,
    public proposalHash: Field,
    public credentialType: Uint<8>
) -> Field {
    // Verify TID is valid
    require(verifyTIDForDAO(tidHash));

    // Verify credential type allows proposal creation
    // Council (4) or Admin (5)
    require(credentialType >= 4);

    // Compute proposal nullifier
    let nullifier = computeNullifier(tidHash, daoId, proposalHash);

    // Emit proposal creation event
    emit<ProposalCreated>(
        nullifier,
        daoId,
        proposalHash,
        block.timestamp
    );

    return nullifier;
}

// ============================================================================
// Batch Membership Verification
// ============================================================================

/**
 * Verify multiple memberships at once
 *
 * Useful for snapshot voting or multi-proposal scenarios.
 *
 * @param tidHash Private: Hash of the prover's TID
 * @param daoId Public: Identifier of the DAO
 * @param actionIds Public: Array of action identifiers
 * @param credentialType Public: Type of credential
 * @returns Array of nullifiers
 */
export circuit verifyMembershipBatch(
    private tidHash: Field,
    public daoId: Field,
    public actionIds: Field[10],
    public actionCount: Uint<8>,
    public credentialType: Uint<8>
) -> Field[10] {
    // Verify membership
    require(verifyTIDForDAO(tidHash));
    require(credentialType >= DAO_MEMBER_CREDENTIAL_TYPE);

    let nullifiers: Field[10] = [];

    // Generate nullifier for each action
    for i in 0..10 {
        if (i < cast<Uint<64>>(actionCount)) {
            let actionId = actionIds[i];
            let nullifier = computeNullifier(tidHash, daoId, actionId);

            // Check not already used
            // require(!nullifiers.contains(nullifier));

            // Register nullifier
            // nullifiers[i] = nullifier;

            nullifiers[i] = nullifier;
        }
    }

    // Emit batch verification event
    emit<BatchMembershipVerified>(
        daoId,
        actionCount,
        block.timestamp
    );

    return nullifiers;
}

// ============================================================================
// Delegation Circuit
// ============================================================================

/**
 * Delegate voting power to another member
 *
 * Allows members to delegate their voting power while maintaining
 * privacy of their identity.
 *
 * @param tidHash Private: Hash of the delegator's TID
 * @param delegateHash Public: Hash of the delegate's TID (or commitment)
 * @param daoId Public: Identifier of the DAO
 * @returns Delegation nullifier
 */
export circuit delegate(
    private tidHash: Field,
    public delegateHash: Field,
    public daoId: Field,
    public credentialType: Uint<8>
) -> Field {
    // Verify delegator has valid membership
    require(verifyTIDForDAO(tidHash));
    require(credentialType >= DAO_MEMBER_CREDENTIAL_TYPE);

    // Compute delegation nullifier
    let delegationId = hash<Poseidon>(tidHash, daoId, block.timestamp);
    let nullifier = computeNullifier(tidHash, daoId, delegationId);

    // Emit delegation event
    emit<VotingDelegated>(
        nullifier,
        daoId,
        delegateHash,
        block.timestamp
    );

    return nullifier;
}

// ============================================================================
// Events
// ============================================================================

/// Emitted when membership is verified
event MembershipVerified(
    nullifier: Field,
    daoId: Field,
    tier: Uint<8>,
    timestamp: Uint<64>
);

/// Emitted when a vote is cast
event VoteCast(
    nullifier: Field,
    daoId: Field,
    proposalId: Field,
    voteChoice: Field,
    timestamp: Uint<64>
);

/// Emitted when a proposal is created
event ProposalCreated(
    nullifier: Field,
    daoId: Field,
    proposalHash: Field,
    timestamp: Uint<64>
);

/// Emitted when batch membership is verified
event BatchMembershipVerified(
    daoId: Field,
    actionCount: Uint<8>,
    timestamp: Uint<64>
);

/// Emitted when voting power is delegated
event VotingDelegated(
    nullifier: Field,
    daoId: Field,
    delegateHash: Field,
    timestamp: Uint<64>
);
