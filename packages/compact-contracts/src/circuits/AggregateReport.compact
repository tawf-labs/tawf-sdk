/**
 * AggregateReport.compact - BAZNAS Aggregate Reporting Circuit
 *
 * This zero-knowledge circuit enables BAZNAS (state zakat institutions)
 * to publish aggregated zakat collection and distribution reports
 * while maintaining individual mustahik privacy.
 *
 * The circuit proves:
 * 1. Total zakat collected matches sum of individual collections
 * 2. Total mustahik served matches individual records
 * 3. Distribution categories sum correctly
 * 4. Report integrity via Merkle root commitment
 *
 * Privacy: Individual mustahik data remains private in the Merkle tree
 *
 * @module AggregateReport
 * @pragma language_version 0.20
 */

pragma language_version 0.20;

// ============================================================================
// Constants
// ============================================================================

/// Maximum number of categories in a report
const MAX_CATEGORIES: Uint<8> = 20;

/// Maximum records per report batch
const MAX_RECORDS: Uint<32> = 10000;

/// Zakat distribution categories
enum ZakatCategory {
    /// Fakahim (poor)
    FAKIR = 0,
    /// Maskin (needy)
    MASAKIN = 1,
    /// Amil (zakat administrators)
    AMIL = 2,
    /// Muallaf (new converts)
    MUALLAF = 3,
    /// Riqab (slaves to be freed)
    RIQAB = 4,
    /// Gharimin (debtors)
    GHARIMIN = 5,
    /// Fisabilillah (in Allah's cause)
    FISABILILLAH = 6,
    /// Ibn Sabil (wayfarers)
    IBN_SABIL = 7
}

/// Report period types
enum ReportPeriod {
    /// Monthly report
    MONTHLY = 0,
    /// Quarterly report
    QUARTERLY = 1,
    /// Annual report
    ANNUAL = 2,
    /// Custom period
    CUSTOM = 3
}

// ============================================================================
// Structs
// ============================================================================

/// Individual zakat collection record (hashed in Merkle tree)
struct ZakatCollectionRecord {
    /// Unique record ID
    recordId: Field;
    /// Muzakki (donor) identifier (hashed)
    muzakkiHash: Field;
    /// Amount collected
    amount: Field;
    /// Type of zakat (zakat mal, zakat fitrah, etc.)
    zakatType: Uint<8>;
    /// Collection timestamp
    timestamp: Uint<64>;
}

/// Individual zakat distribution record (hashed in Merkle tree)
struct ZakatDistributionRecord {
    /// Unique record ID
    recordId: Field;
    /// Mustahik identifier (hashed)
    mustahikHash: Field;
    /// Amount distributed
    amount: Field;
    /// Distribution category
    category: ZakatCategory;
    /// Distribution timestamp
    timestamp: Uint<64>;
}

/// Category-wise distribution summary
struct CategoryDistribution {
    /// Category type
    category: ZakatCategory;
    /// Total amount distributed in this category
    totalAmount: Field;
    /// Number of recipients in this category
    recipientCount: Uint<32>;
}

/// Aggregate zakat report
struct AggregateZakatReport {
    /// Report identifier
    reportId: Field;
    /// BAZNAS institution identifier
    institutionId: Field;
    /// Report period
    period: ReportPeriod;
    /// Period start date
    periodStart: Uint<64>;
    /// Period end date
    periodEnd: Uint<64>;
    /// Total zakat collected
    totalCollected: Field;
    /// Total zakat distributed
    totalDistributed: Field;
    /// Total mustahik served
    totalMustahik: Uint<32>;
    /// Distribution by category
    distributions: CategoryDistribution[MAX_CATEGORIES];
    /// Number of active categories
    categoryCount: Uint<8>;
    /// Merkle root of collection records
    collectionRoot: Field;
    /// Merkle root of distribution records
    distributionRoot: Field;
    /// Report creation timestamp
    timestamp: Uint<64>;
    /// BAZNAS signature
    signature: Field;
}

/// Report verification result
struct ReportVerificationResult {
    /// Whether report is valid
    isValid: Bool;
    /// Report hash
    reportHash: Field;
    /// Verification timestamp
    timestamp: Uint<64>;
}

/// Audited summary
struct AuditedSummary {
    /// Total reported across all institutions
    totalCollected: Field;
    /// Total distributed across all institutions
    totalDistributed: Field;
    /// Total mustahik served
    totalMustahik: Uint<32>;
    /// Number of institutions reporting
    institutionCount: Uint<16>;
    /// Aggregation timestamp
    timestamp: Uint<64>;
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Compute hash of a collection record
/// @param record The collection record
/// @returns Hash of the record
function hashCollectionRecord(record: ZakatCollectionRecord) -> Field {
    return hash<Poseidon>(
        record.recordId,
        record.muzakkiHash,
        record.amount,
        cast<Field>(record.zakatType),
        cast<Field>(record.timestamp)
    );
}

/// Compute hash of a distribution record
/// @param record The distribution record
/// @returns Hash of the record
function hashDistributionRecord(record: ZakatDistributionRecord) -> Field {
    return hash<Poseidon>(
        record.recordId,
        record.mustahikHash,
        record.amount,
        cast<Field>(record.category),
        cast<Field>(record.timestamp)
    );
}

/// Compute aggregate report hash
/// @param report The aggregate report
/// @returns Hash of the report
function hashReport(report: AggregateZakatReport) -> Field {
    // Start with basic info
    let h = hash<Poseidon>(
        report.reportId,
        report.institutionId,
        cast<Field>(report.period),
        cast<Field>(report.periodStart),
        cast<Field>(report.periodEnd)
    );

    // Add totals
    h = hash<Poseidon>(h, report.totalCollected, report.totalDistributed);
    h = hash<Poseidon>(h, cast<Field>(report.totalMustahik), cast<Field>(report.categoryCount));

    // Add Merkle roots
    h = hash<Poseidon>(h, report.collectionRoot, report.distributionRoot);
    h = hash<Poseidon>(h, cast<Field>(report.timestamp), report.signature);

    return h;
}

/// Verify category distributions sum to total distributed
/// @param distributions Array of category distributions
/// @param categoryCount Number of active categories
/// @param totalDistributed Total amount to verify against
/// @returns true if sums match
function verifyDistributionSum(
    distributions: CategoryDistribution[MAX_CATEGORIES],
    categoryCount: Uint<8>,
    totalDistributed: Field
) -> Bool {
    let calculatedTotal: Field = 0;

    for i in 0..MAX_CATEGORIES {
        if (i < cast<Uint<64>>(categoryCount)) {
            calculatedTotal = calculatedTotal + distributions[i].totalAmount;
        }
    }

    return calculatedTotal == totalDistributed;
}

/// Verify recipient counts sum to total mustahik
/// @param distributions Array of category distributions
/// @param categoryCount Number of active categories
/// @param totalMustahik Total to verify against
/// @returns true if counts match
function verifyRecipientCount(
    distributions: CategoryDistribution[MAX_CATEGORIES],
    categoryCount: Uint<8>,
    totalMustahik: Uint<32
) -> Bool {
    let calculatedTotal: Uint<32> = 0;

    for i in 0..MAX_CATEGORIES {
        if (i < cast<Uint<64>>(categoryCount)) {
            calculatedTotal = calculatedTotal + distributions[i].recipientCount;
        }
    }

    return calculatedTotal == totalMustahik;
}

/// Validate report period dates
/// @param periodStart Start date
/// @param periodEnd End date
/// @returns true if dates are valid
function validatePeriod(periodStart: Uint<64>, periodEnd: Uint<64) -> Bool {
    // Period must be in the past
    require(periodEnd < block.timestamp);

    // Start must be before end
    require(periodStart < periodEnd);

    // Period should not exceed 1 year
    let oneYear: Uint<64> = 365 * 24 * 60 * 60;
    require((periodEnd - periodStart) <= oneYear);

    return true;
}

// ============================================================================
// Main Circuit
// ============================================================================

/**
 * Generate and verify an aggregate zakat report
 *
 * This circuit allows BAZNAS to prove the integrity of their aggregated
 * zakat collection and distribution data while maintaining individual
 * mustahik privacy through Merkle tree commitments.
 *
 * @param report The aggregate report to verify
 * @param collectionRecordsHash Hash of all collection records
 * @param distributionRecordsHash Hash of all distribution records
 * @returns Verification result
 */
export circuit generateAggregateReport(
    public report: AggregateZakatReport,
    private collectionRecordsHash: Field,
    private distributionRecordsHash: Field
) -> ReportVerificationResult {
    // Validate report period
    require(validatePeriod(report.periodStart, report.periodEnd));

    // Verify distributions sum correctly
    require(verifyDistributionSum(
        report.distributions,
        report.categoryCount,
        report.totalDistributed
    ));

    // Verify recipient counts
    require(verifyRecipientCount(
        report.distributions,
        report.categoryCount,
        report.totalMustahik
    ));

    // Verify total distributed doesn't exceed total collected
    // Note: Undistributed funds are allowed (carried forward)
    // require(report.totalDistributed <= report.totalCollected);

    // Verify Merkle roots match provided hashes
    require(report.collectionRoot == collectionRecordsHash);
    require(report.distributionRoot == distributionRecordsHash);

    // Compute report hash
    let reportHash = hashReport(report);

    // Emit verification event
    emit<ReportGenerated>(
        reportHash,
        report.institutionId,
        report.totalCollected,
        report.totalDistributed,
        report.totalMustahik,
        block.timestamp
    );

    let result = ReportVerificationResult {
        isValid: true,
        reportHash: reportHash,
        timestamp: block.timestamp
    };

    return result;
}

// ============================================================================
// Multi-Institution Aggregation
// ============================================================================

/**
 * Aggregate reports from multiple BAZNAS institutions
 *
 * This creates a regional or national summary while maintaining
 * individual institution privacy.
 *
 * @param institutionReports Array of institution report hashes
 * @param institutionCount Number of institutions
 * @param totalCollected Verified total collected
 * @param totalDistributed Verified total distributed
 * @param totalMustahik Verified total mustahik
 * @returns Aggregated summary
 */
export circuit aggregateInstitutionReports(
    private institutionReports: Field[100],
    public institutionCount: Uint<16>,
    public totalCollected: Field,
    public totalDistributed: Field,
    public totalMustahik: Uint<32>
) -> AuditedSummary {
    // Validate institution count
    require(institutionCount > 0);
    require(institutionCount <= 100);

    // Compute aggregated hash
    let aggregatedHash: Field = 0;
    for i in 0..100 {
        if (i < cast<Uint<64>>(institutionCount)) {
            aggregatedHash = hash<Poseidon>(aggregatedHash, institutionReports[i]);
        }
    }

    // Create summary
    let summary = AuditedSummary {
        totalCollected: totalCollected,
        totalDistributed: totalDistributed,
        totalMustahik: totalMustahik,
        institutionCount: institutionCount,
        timestamp: block.timestamp
    };

    // Emit aggregation event
    emit<ReportsAggregated>(
        aggregatedHash,
        institutionCount,
        totalCollected,
        totalDistributed,
        block.timestamp
    );

    return summary;
}

// ============================================================================
// Proof of Individual Record Inclusion
// ============================================================================

/**
 * Prove a record is included in the report
 *
 * Allows individual mustahik to verify their record was included
 * in the aggregate report without revealing their identity.
 *
 * @param record The individual record
 * @param merkleProof Merkle proof of inclusion
 * @param reportRoot The root to verify against
 * @returns true if included
 */
export circuit proveRecordInclusion(
    private record: ZakatDistributionRecord,
    public merkleProof: Field[32],
    public proofLength: Uint<8>,
    public reportRoot: Field
) -> Bool {
    // Compute leaf hash
    let leafHash = hashDistributionRecord(record);

    // Verify Merkle proof
    let computedRoot = leafHash;
    for i in 0..32 {
        if (i < cast<Uint<64>>(proofLength)) {
            computedRoot = hash<Poseidon>(computedRoot, merkleProof[i]);
        }
    }

    // Verify against expected root
    require(computedRoot == reportRoot);

    // Emit inclusion proof event
    emit<RecordInclusionProven>(leafHash, reportRoot, block.timestamp);

    return true;
}

// ============================================================================
// Category Compliance Verification
// ============================================================================

/**
 * Verify distribution complies with Sharia (8 asnaf categories)
 *
 * Ensures distribution follows proper Islamic guidelines.
 *
 * @param distributions Category distribution data
 * @param categoryCount Number of categories with non-zero distribution
/// @returns Compliance commitment
 */
export circuit verifyShariaCompliance(
    public distributions: CategoryDistribution[MAX_CATEGORIES],
    public categoryCount: Uint<8>
) -> Field {
    // All distributions should be to valid categories (0-7)
    for i in 0..MAX_CATEGORIES {
        if (i < cast<Uint<64>>(categoryCount)) {
            let cat = cast<Uint<64>>(distributions[i].category);
            require(cat < 8); // Valid asnaf categories
        }
    }

    // Compute compliance commitment
    let complianceHash: Field = 0;
    for i in 0..MAX_CATEGORIES {
        if (i < cast<Uint<64>>(categoryCount)) {
            complianceHash = hash<Poseidon>(
                complianceHash,
                distributions[i].totalAmount,
                cast<Field>(distributions[i].recipientCount),
                cast<Field>(distributions[i].category)
            );
        }
    }

    emit<ShariaComplianceVerified>(complianceHash, block.timestamp);

    return complianceHash;
}

// ============================================================================
// Events
// ============================================================================

/// Emitted when a report is generated
event ReportGenerated(
    reportHash: Field,
    institutionId: Field,
    totalCollected: Field,
    totalDistributed: Field,
    totalMustahik: Uint<32>,
    timestamp: Uint<64>
);

/// Emitted when reports are aggregated
event ReportsAggregated(
    aggregatedHash: Field,
    institutionCount: Uint<16>,
    totalCollected: Field,
    totalDistributed: Field,
    timestamp: Uint<64>
);

/// Emitted when record inclusion is proven
event RecordInclusionProven(
    leafHash: Field,
    reportRoot: Field,
    timestamp: Uint<64>
);

/// Emitted when Sharia compliance is verified
event ShariaComplianceVerified(
    complianceHash: Field,
    timestamp: Uint<64>
);
